# MainStorage Astronaut code-block palette.
theme = facade
cursor-style = "block"
cursor-style-blink = false

# Dark smoked glass: broad wallpaper colours remain visible behind text.
background-opacity = 0.69
background-blur = 42

# ( ) i $ <=

window-padding-balance = true
window-padding-x = 14
window-padding-y = 14
# window-padding-color = extend

# macbook
# SF Mono — the Xcode font, in a heavier weight. Nerd Font icons still work:
# Ghostty has the Nerd Font symbols built in and falls back to them.
font-size = 14.5
font-family = "SF Mono"
adjust-cell-height = 4
font-thicken = true
font-style = bold
font-style-bold = heavy

# Previous font:
# font-family = "0xProto Nerd Font Propo"
# font-feature = cv31
# font-feature = cv06
# font-feature = ss04
# font-feature = -calt

# font-family = "Iosevka Fixed"
# font-size = 13.0
# adjust-cell-height = 8
# adjust-cell-width = 3
# font-feature = cv31
# font-feature = cv06
# font-feature = ss04
# font-feature = -calt

# font-family = "FiraCode Nerd Font Propo" 
# font-size = 13.0
# adjust-cell-height = 9
# adjust-cell-width = 1
# font-feature = cv31
# font-feature = cv06
# font-feature = ss04
# font-feature = -calt

mouse-hide-while-typing = true
# no macOS scrollbar over the terminal (mouse / keys still scroll)
scrollbar = never
macos-option-as-alt = true
auto-update = check
macos-icon = retro
macos-icon-frame = plastic
macos-window-buttons = hidden
macos-titlebar-style = hidden


# custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/cursor_tail.glsl
# custom-shader = shaders/bettercrt.glsl
# custom-shader = shaders/bloom.glsl

