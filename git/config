# name and e-mail live in ./identity, which is not in the repo
# (see identity.example)
[include]
	path = identity

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	# astronaut-light: code colours come from the terminal's ANSI palette
	syntax-theme = ansi
	light = true
	minus-style = syntax "#f0d6c8"
	minus-emph-style = syntax "#e6b49c"
	plus-style = syntax "#e0e4c6"
	plus-emph-style = syntax "#c9d29c"
	line-numbers-zero-style = "#8f8276"
	line-numbers-minus-style = "#b0381a"
	line-numbers-plus-style = "#5d6a1c"
	line-numbers-left-style = "#c9b99c"
	line-numbers-right-style = "#c9b99c"
	file-style = "#b4541b" bold
	file-decoration-style = "#c9b99c" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#1f6b5c"
	hunk-header-line-number-style = "#8c6a12"
	hunk-header-decoration-style = "#c9b99c" box
	commit-decoration-style = "#b4541b" box ul

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	lg = log --graph --oneline --decorate --all
	amend = commit --amend --no-edit
