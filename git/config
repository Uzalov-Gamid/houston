# name and e-mail live in ./identity, which is not in the repo
# (see identity.example)
[include]
	path = identity

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	# MainStorage Astronaut code-block colours
	syntax-theme = ansi
	dark = true
	minus-style = syntax "#3e2624"
	minus-emph-style = syntax "#623936"
	plus-style = syntax "#28352a"
	plus-emph-style = syntax "#3c5138"
	line-numbers-zero-style = "#a9998b"
	line-numbers-minus-style = "#e4836a"
	line-numbers-plus-style = "#b5b07a"
	line-numbers-left-style = "#665346"
	line-numbers-right-style = "#665346"
	file-style = "#ef8f4c" bold
	file-decoration-style = "#665346" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#98c4ba"
	hunk-header-line-number-style = "#e5c15a"
	hunk-header-decoration-style = "#665346" box
	commit-decoration-style = "#ef8f4c" box ul

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	lg = log --graph --oneline --decorate --all
	amend = commit --amend --no-edit
[user]
	name = Gamid Uzalov
	email = uzalovgamid@gmail.com
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
