# This repo is ~/.config itself. Everything is ignored by default and
# configs are opted in below, so tokens, caches and app state
# (gh, atuin keys, ticktick-cli, colima VM disks, raycast, ...) never
# end up on GitHub by accident.
/*
!/.gitignore
!/.editorconfig
!/README.md
!/Brewfile
!/install.sh
!/python/
!/cursor/
!/screenshots/
!/CHANGELOG.md
!/palette/

# Window management & menu bar
!/aerospace/
!/borders/
!/sketchybar/
!/karabiner/
/karabiner/automatic_backups/

# Shells & prompts
!/fish/
/fish/fish_variables
/fish/functions/
/fish/completions/
/fish/conf.d/*
!/fish/conf.d/prompt.fish
!/zsh/
/zsh/.zcompdump*
/zsh/.zsh_sessions/
!/starship.toml

# Terminal & CLI tools
!/ghostty/
!/tmux/
!/nvim/
/nvim/lua/local_profile.lua
!/git/
/git/identity
!/atuin/
/atuin/*
!/atuin/config.toml
!/atuin/README.md
!/btop/
!/fastfetch/
!/glow/
!/colima/
/colima/*
!/colima/README.md
!/colima/default/
/colima/default/*
!/colima/default/colima.yaml

# Editors
!/zed/
/zed/*
!/zed/settings.json
!/zed/keymap.json
!/zed/tasks.json
!/zed/themes/

.DS_Store

# local backups made before edits (name.bak, name.bak-2026-11-10, …)
*.bak
*.bak-*
*.before-*
